# --- PlatformIO и VS Code (генерируются; .vscode/extensions.json - в репозитории) ---
.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# --- Python ---
__pycache__/
*.pyc

# --- Генерируется при каждой сборке (Scripts/build_web.py, build_info.py) ---
CO2_Sensor_NRF24/include/web_files.h
CO2_Sensor_NRF24/include/build_info.h

# --- work/: в репозитории - docs_txt/ (текст даташитов), fonts/Montserrat-SemiBold.ttf (исходник
#     include/font_digits.h), platformio.ini.bak_old_versions (откат на Arduino 2.x).
#     Не нужно: выход скриптов (png, .exe тестов, логи), кэш d3, разовые патчи и отладка ---
work/png/
work/d3/
work/step/
work/*.exe
work/*.log
work/*.bak
work/patch_*.py
work/fix_*.py
work/dbg_*.py
work/check_*.py
work/*.cpp.txt
work/fonts/*
!work/fonts/Montserrat-SemiBold.ttf

# --- Fan/ (ATtiny44A, Atmel Studio 6.2, Proteus): служебные и резервные файлы IDE ---
Fan/debug/
Fan/Debug/
Fan/Release/
*.atsuo
*.pdsprj.*.workspace
Fan/Last Loaded *.DBK
Fan/scripts/
Fan/work/
Fan/CLAUDE.md

# --- Claude Code: личные разрешения (у каждого свои), в репозиторий не нужны ---
**/.claude/settings.local.json
